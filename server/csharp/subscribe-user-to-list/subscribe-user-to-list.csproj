<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>subscribe_user_to_list</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

  <!-- 
    Reference to the official Courier C# SDK (https://github.com/trycourier/courier-csharp)
    The SDK should be cloned in the server/ directory:
      git clone https://github.com/trycourier/courier-csharp.git server/courier-csharp
  -->
  <ItemGroup>
    <ProjectReference Include="../../courier-csharp/src/Courier/Courier.csproj" />
  </ItemGroup>

</Project>
