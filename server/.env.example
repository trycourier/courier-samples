# Copy this file to .env in this directory, then fill in your own values.
#   cp server/.env.example server/.env
#
# Every server sample reads from this one file.

# Your Courier API key, from https://app.courier.com/settings/api-keys
COURIER_API_KEY=YOUR_COURIER_API_KEY

# --- Recipients ------------------------------------------------------------
COURIER_GET_USER_PROFILE_USER_ID=user_123
COURIER_UPSERT_USER_USER_ID=user_123
COURIER_UPSERT_USER_EMAIL=nomen.nescio@example.com
COURIER_UPSERT_USER_NAME="Nomen Nescio"
COURIER_UPSERT_USER_PHONE_NUMBER=+15555550100

# --- Sending ---------------------------------------------------------------
# Template ids look like nt_01kx4h2jdafq8bk9aftxak4b40
COURIER_SEND_TEMPLATE_TO_USER_ID_USER_ID=user_123
COURIER_SEND_TEMPLATE_TO_USER_ID_TEMPLATE_ID=YOUR_TEMPLATE_ID

COURIER_SEND_TEMPLATE_TO_EMAIL_EMAIL=nomen.nescio@example.com
COURIER_SEND_TEMPLATE_TO_EMAIL_TEMPLATE_ID=YOUR_TEMPLATE_ID

COURIER_SEND_TEMPLATE_TO_LIST_LIST_ID=example.list
COURIER_SEND_TEMPLATE_TO_LIST_TEMPLATE_ID=YOUR_TEMPLATE_ID

COURIER_SEND_TEMPLATE_TO_TENANT_TENANT_ID=tenant_123
COURIER_SEND_TEMPLATE_TO_TENANT_ID_TEMPLATE_ID=YOUR_TEMPLATE_ID

COURIER_SEND_TEMPLATE_TO_AUDIENCE_AUDIENCE_ID=YOUR_AUDIENCE_ID

# --- Lists -----------------------------------------------------------------
COURIER_CREATE_LIST_LIST_ID=example.list
COURIER_CREATE_LIST_LIST_NAME="My List Name"

COURIER_SUBSCRIBE_USER_TO_LIST_LIST_ID=example.list
COURIER_SUBSCRIBE_USER_TO_LIST_USER_ID=user_123

COURIER_UNSUBSCRIBE_USER_FROM_LIST_LIST_ID=example.list
COURIER_UNSUBSCRIBE_USER_FROM_LIST_USER_ID=user_123

# --- Auth (JWT for client SDKs) --------------------------------------------
COURIER_GENERATE_JWT_USER_ID=user_123
COURIER_EXPIRES_IN_DAYS=30
