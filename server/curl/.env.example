# Courier API Configuration
COURIER_API_KEY=your_api_key_here

# Generate JWT
COURIER_GENERATE_JWT_USER_ID=your_user_id
COURIER_EXPIRES_IN_DAYS=30

# Send Template to Email
COURIER_SEND_TEMPLATE_TO_EMAIL_EMAIL=your_email@example.com
COURIER_SEND_TEMPLATE_TO_EMAIL_TEMPLATE_ID=your_template_id

# Send Template to User ID
COURIER_SEND_TEMPLATE_TO_USER_ID_USER_ID=your_user_id
COURIER_SEND_TEMPLATE_TO_USER_ID_TEMPLATE_ID=your_template_id

# Send Template to List
COURIER_SEND_TEMPLATE_TO_LIST_LIST_ID=your_list_id
COURIER_SEND_TEMPLATE_TO_LIST_TEMPLATE_ID=your_template_id

# Send Template to Audience
COURIER_SEND_TEMPLATE_TO_AUDIENCE_AUDIENCE_ID=your_audience_id

# Send Template to Tenant
COURIER_SEND_TEMPLATE_TO_TENANT_TENANT_ID=your_tenant_id
COURIER_SEND_TEMPLATE_TO_TENANT_ID_TEMPLATE_ID=your_template_id

# Create List
COURIER_CREATE_LIST_LIST_ID=your_list_id
COURIER_CREATE_LIST_LIST_NAME=your_list_name

# Get User Profile
COURIER_GET_USER_PROFILE_USER_ID=your_user_id

# Upsert User
COURIER_UPSERT_USER_USER_ID=your_user_id
COURIER_UPSERT_USER_EMAIL=your_email@example.com
COURIER_UPSERT_USER_NAME=your_user_name
COURIER_UPSERT_USER_PHONE_NUMBER=your_phone_number

# Subscribe User to List
COURIER_SUBSCRIBE_USER_TO_LIST_LIST_ID=your_list_id
COURIER_SUBSCRIBE_USER_TO_LIST_USER_ID=your_user_id

# Unsubscribe User from List
COURIER_UNSUBSCRIBE_USER_FROM_LIST_LIST_ID=your_list_id
COURIER_UNSUBSCRIBE_USER_FROM_LIST_USER_ID=your_user_id
